{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"$PLUGIN_ROOT/hooks/scripts/bootstrap.js\" codex || exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:PLUGIN_ROOT\\hooks\\scripts\\bootstrap.js\" codex }",
            "timeout": 5,
            "statusMessage": "Loading senpai mode..."
          }
        ]
      }
    ]
  }
}
